# SNAP-AI Docker environment
# This file is read by docker compose automatically.

LLM_BACKEND=vllm
VLLM_HOST=http://131.152.136.65:8000
VLLM_MODEL=openai/gpt-oss-120b

# Deterministic inference
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096

# GPU Configuration (4× A100-40GB for 120B model)
VLLM_GPU_DEVICES=0,1,2,3
VLLM_TP_SIZE=4
VLLM_QUANTIZATION=mxfp4
VLLM_MAX_MODEL_LEN=32768

# Database & Redis (must match the password the postgres volume was initialized with)
POSTGRES_PASSWORD=snapai_dev
REDIS_PASSWORD=

# Authentication
JWT_SECRET=086be5be8123852735e0f60a67b1c1de1b849eb21deae544fc08280287a42a2d
ADMIN_PASSWORD=Pancreas123
