# SNAP-AI Configuration
# Copy this file to .env and adjust values

# ===================
# Environment
# ===================
ENVIRONMENT=development  # development | production

# ===================
# LLM Backend Selection
# ===================
# Choose your backend: "ollama" (development) or "vllm" (production)
LLM_BACKEND=ollama

# ===================
# Model Selection (CHANGE THIS TO SWITCH MODELS)
# ===================
# For Ollama (development/testing):
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# For vLLM (production with GPUs):
VLLM_HOST=http://vllm:8000
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# ===================
# AVAILABLE FREE MODELS (for 8x A100 GPUs)
# ===================
# Tier 1 - Best Quality (Recommended):
#   VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct          # ~140GB VRAM, Apache 2.0
#   VLLM_MODEL=meta-llama/Llama-3.1-70B-Instruct  # ~140GB VRAM, Llama 3.1 License
#   VLLM_MODEL=deepseek-ai/DeepSeek-V2.5          # ~160GB VRAM, MIT License
#   VLLM_MODEL=mistralai/Mixtral-8x22B-Instruct-v0.1  # ~100GB VRAM, Apache 2.0
#
# Tier 2 - Good Balance (Faster):
#   VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct          # ~64GB VRAM, Apache 2.0
#   VLLM_MODEL=google/gemma-2-27b-it              # ~55GB VRAM, Gemma License
#   VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct   # ~16GB VRAM, Llama 3.1 License
#   VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3 # ~14GB VRAM, Apache 2.0
#
# Quantized Models (Lower VRAM):
#   VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ      # ~36GB VRAM, AWQ quantized
#   VLLM_MODEL=TheBloke/Llama-2-70B-Chat-AWQ      # ~36GB VRAM, AWQ quantized
#
# For Ollama (development):
#   OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M       # ~4.5GB VRAM
#   OLLAMA_MODEL=qwen2.5:14b-instruct-q4_K_M      # ~9GB VRAM
#   OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M      # ~5GB VRAM
#   OLLAMA_MODEL=mistral:7b-instruct-q4_K_M       # ~4.5GB VRAM

# ===================
# LLM Inference Settings
# ===================
LLM_TEMPERATURE=0.0      # 0.0 = deterministic (recommended for clinical)
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=600          # 10 minutes

# ===================
# Database
# ===================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=snapai
POSTGRES_USER=snapai
POSTGRES_PASSWORD=changeme_in_production

# ===================
# Redis
# ===================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ===================
# API Configuration
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ===================
# Upload Settings
# ===================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.docx,.txt

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===================
# Versioning
# ===================
PROMPT_VERSION=1.3
MODEL_VERSION=qwen2.5-7b

# ===================
# Deployment (Remote/DGX)
# ===================
# Frontend port (use 8080+ on shared servers where port 80 needs sudo)
FRONTEND_PORT=8080

# GPU selection (set to specific GPU index on shared servers, e.g. 7)
NVIDIA_VISIBLE_DEVICES=all
