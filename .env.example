# SNAP-AI Configuration
# Copy this file to .env and adjust values

# ===================
# Environment
# ===================
ENVIRONMENT=development  # development | production

# ===================
# LLM Configuration
# ===================
# For development (Ollama)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# For production (vLLM)
VLLM_HOST=http://vllm:8000
VLLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ

# LLM inference settings
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=300

# ===================
# Database
# ===================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=snapai
POSTGRES_USER=snapai
POSTGRES_PASSWORD=changeme_in_production

# ===================
# Redis
# ===================
REDIS_HOST=redis
REDIS_PORT=6379

# ===================
# API Configuration
# ===================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ===================
# Upload Settings
# ===================
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.docx,.txt

# ===================
# Logging
# ===================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===================
# Versioning
# ===================
PROMPT_VERSION=1.3
MODEL_VERSION=qwen2.5-7b
