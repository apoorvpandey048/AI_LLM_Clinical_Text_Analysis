# ===========================================
# SNAP-AI Production Environment Configuration
# ===========================================
# Copy to .env and fill in the values

# Environment
ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=snapai
POSTGRES_USER=snapai
POSTGRES_PASSWORD=snapai_prod_2026

# Redis
REDIS_PASSWORD=changeme

# vLLM / GPT-OSS-120B
LLM_BACKEND=vllm
VLLM_HOST=http://vllm:8000
VLLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=900

# GPU Configuration
# GPUs 4 and 7 have the most free memory on the DGX
VLLM_GPU_DEVICES=4,7
VLLM_MAX_MODEL_LEN=8192

# HuggingFace Token (needed for gated models)
HF_TOKEN=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

# Authentication
JWT_SECRET=086be5be8123852735e0f60a67b1c1de1b849eb21deae544fc08280287a42a2d
ADMIN_PASSWORD=Pancreas123

# Frontend
FRONTEND_PORT=8080

# Cloudflare Tunnel (for permanent https://snapai.com access)
# Get this after running: cloudflared tunnel create snapai
CLOUDFLARE_TUNNEL_TOKEN=

# Logging
LOG_LEVEL=INFO
