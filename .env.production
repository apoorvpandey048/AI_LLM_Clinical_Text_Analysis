# ===========================================
# SNAP-AI Production Environment Configuration
# ===========================================
# Copy to .env and fill in the values

# Environment
ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=snapai
POSTGRES_USER=snapai
POSTGRES_PASSWORD=snapai_prod_2026

# Redis
REDIS_PASSWORD=changeme

# vLLM / GPT-OSS-120B
# Options: vllm, ollama, stub (stub = local UI testing without GPU)
LLM_BACKEND=vllm
# On Mac/Windows Docker Desktop use: http://host.docker.internal:8000
# On Linux (DGX, bare-metal) use the machine's real IP, e.g.:
#   VLLM_HOST=http://131.152.136.65:8000
VLLM_HOST=http://host.docker.internal:8000
VLLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=16384
LLM_TIMEOUT=900

# GPU Configuration — DGX-01 (dbe-sl21-01)
# GPT-OSS-120B has 64 attention heads → TP must divide 64 → TP=4 works
# TP=4 across 4 GPUs = 160GB total → fits MXFP4 weights + KV cache
VLLM_GPU_DEVICES=0,1,2,3
VLLM_TP_SIZE=4
VLLM_QUANTIZATION=mxfp4
VLLM_MAX_MODEL_LEN=32768

# HuggingFace Token (needed for gated models)
HF_TOKEN=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

# Authentication
JWT_SECRET=086be5be8123852735e0f60a67b1c1de1b849eb21deae544fc08280287a42a2d
ADMIN_PASSWORD=Pancreas123

# Frontend
FRONTEND_PORT=8080

# Cloudflare Tunnel (for permanent https://snapai.com access)
# Get this after running: cloudflared tunnel create snapai
CLOUDFLARE_TUNNEL_TOKEN=

# Logging
LOG_LEVEL=INFO
