# ===========================================
# SNAP-AI Production Environment Configuration
# ===========================================
# Copy to .env and fill in the values

# Environment
ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=snapai
POSTGRES_USER=snapai
POSTGRES_PASSWORD=snapai_prod_2026

# Redis
REDIS_PASSWORD=changeme

# vLLM / GPT-OSS-120B
# Options: vllm, ollama, stub (stub = local UI testing without GPU)
LLM_BACKEND=vllm
VLLM_HOST=http://host.docker.internal:8000
VLLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=900

# GPU Configuration — DGX-01 (dbe-sl21-01)
# GPUs 0-1 occupied by sidaty, GPUs 5-7 by sergei → use GPUs 2,3 (free, A100-40GB each)
# GPT-OSS-120B has 64 attention heads → TP must divide 64 (1,2,4,8,16,32,64)
# TP=2 across 2 GPUs = 80GB total → fits ~60GB MXFP4 weights + KV cache
VLLM_GPU_DEVICES=2,3
VLLM_TP_SIZE=2
VLLM_QUANTIZATION=mxfp4
VLLM_MAX_MODEL_LEN=4096

# HuggingFace Token (needed for gated models)
HF_TOKEN=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

# Authentication
JWT_SECRET=086be5be8123852735e0f60a67b1c1de1b849eb21deae544fc08280287a42a2d
ADMIN_PASSWORD=Pancreas123

# Frontend
FRONTEND_PORT=8080

# Cloudflare Tunnel (for permanent https://snapai.com access)
# Get this after running: cloudflared tunnel create snapai
CLOUDFLARE_TUNNEL_TOKEN=

# Logging
LOG_LEVEL=INFO
