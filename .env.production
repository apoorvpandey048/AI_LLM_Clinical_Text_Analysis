# ===========================================
# SNAP-AI Production Environment Configuration
# ===========================================
# Copy to .env and fill in the values

# Environment
ENVIRONMENT=production

# PostgreSQL
POSTGRES_DB=snapai
POSTGRES_USER=snapai
POSTGRES_PASSWORD=snapai_prod_2026

# Redis
REDIS_PASSWORD=changeme

# vLLM / GPT-OSS-120B
# Options: vllm, ollama, stub (stub = local UI testing without GPU)
LLM_BACKEND=vllm
VLLM_HOST=http://host.docker.internal:8000
VLLM_MODEL=openai/gpt-oss-120b
LLM_MAX_TOKENS=8192
LLM_TIMEOUT=900

# GPU Configuration — DGX-01 (dbe-sl21-01)
# GPU 0: fully free (40,443 MiB), single GPU with tensor-parallel-size=1
# GPT-OSS-120B has 5.1B active params with MXFP4 — fits on single A100-40GB
VLLM_GPU_DEVICES=0
VLLM_MAX_MODEL_LEN=8192

# HuggingFace Token (needed for gated models)
HF_TOKEN=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

# Authentication
JWT_SECRET=086be5be8123852735e0f60a67b1c1de1b849eb21deae544fc08280287a42a2d
ADMIN_PASSWORD=Pancreas123

# Frontend
FRONTEND_PORT=8080

# Cloudflare Tunnel (for permanent https://snapai.com access)
# Get this after running: cloudflared tunnel create snapai
CLOUDFLARE_TUNNEL_TOKEN=

# Logging
LOG_LEVEL=INFO
